<!DOCTYPE html>


<html data-build="<%= build %>" lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1, viewport-fit=cover" name="viewport"/>
<title>Dr Dixit Bilaspur Hospital — Paediatric Orthopedics, Gynecology &amp; Physiotherapy</title>
<meta content="Dr Dixit Bilaspur Hospital, Mangla, Bilaspur. Chhattisgarh's dedicated paediatric orthopedic hospital, with obstetrics, gynecology, infertility care and paediatric &amp; spinal physiotherapy under one roof. Ayushman Bharat empanelled." name="description"/>
<meta content="#0A5249" name="theme-color"/>
<link href="data:image/jpeg;base64," rel="icon"/>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&amp;family=Karla:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
<style>
/* ============ TOKENS ============ */
:root{
  --ink:#12302A;          /* deep pine — body text */
  --ink-soft:#4B665F;     /* secondary text */
  --teal:#0E6F63;         /* orthopedics */
  --teal-deep:#0A5249;
  --rose:#B65272;         /* gynecology & maternity */
  --marigold:#E39B2B;     /* physiotherapy */
  --paper:#F1F5F3;        /* page background */
  --card:#FFFFFF;
  --line:#DCE6E2;
  --a:var(--teal);        /* per-section accent, overridden locally */

  --wrap:1180px;
  --nav-wrap:1440px;      /* header row is wider than the page column so 8 links + button fit */
  --gut:22px;             /* page gutter — shrinks on small screens */
  --navh:74px;            /* sticky header height */
  --r-lg:22px; --r-md:14px; --r-sm:9px;

  --f-display:"Fraunces", Georgia, "Times New Roman", serif;
  --f-body:"Karla", "Segoe UI", system-ui, -apple-system, sans-serif;

  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:calc(var(--navh) + 8px + env(safe-area-inset-top,0px));-webkit-text-size-adjust:100%}
body{
  margin:0;background:var(--paper);color:var(--ink);
  font-family:var(--f-body);font-size:17px;line-height:1.65;
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}
img{max-width:100%;display:block}
/* <figure> carries a default 40px left/right margin in every browser. It was squeezing the doctor
   cards (and the hospital photo) into thin slivers at desktop widths. */
figure{margin:0}
a{color:var(--teal-deep)}
h1,h2,h3,h4{font-family:var(--f-display);font-weight:600;line-height:1.14;margin:0 0 .5em;letter-spacing:-.01em;overflow-wrap:break-word}
h1{font-size:clamp(1.95rem,5.4vw,3.6rem);line-height:1.08}
h2{font-size:clamp(1.55rem,3.6vw,2.5rem)}
h3{font-size:clamp(1.15rem,2.2vw,1.55rem)}
h4{font-size:1.02rem;font-family:var(--f-body);font-weight:700;letter-spacing:.01em}
p,li,dd,dt,td,th,figcaption,cite{overflow-wrap:break-word}
p{margin:0 0 1em;max-width:68ch}
.wrap{max-width:var(--wrap);margin:0 auto;padding:0 var(--gut)}
.section{padding:78px 0}
.lede{font-size:1.06rem;color:var(--ink-soft);max-width:64ch}

/* Grid children must be allowed to shrink, or long words blow the layout out.
   This single rule is what stops cards "breaking" on narrow screens. */
.hero__grid>*,.hero__stack>*,.profile__grid>*,.cgrid>*,.ayush__grid>*,
.trio>*,.svc>*,.revs>*,.subgrid>*,.gal>*,.foot__grid>*,.strip li,.facil li{min-width:0}

/* ============ BUTTONS ============ */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:.5em;
  font-family:var(--f-body);font-weight:600;font-size:.98rem;
  padding:.78em 1.5em;border-radius:999px;border:1.5px solid transparent;
  text-decoration:none;cursor:pointer;transition:background .18s,color .18s,border-color .18s;
  white-space:normal;text-align:center;max-width:100%;line-height:1.3;
}
.btn--solid{background:var(--a);color:#fff}
.btn--solid:hover{background:var(--ink)}
.btn--ghost{border-color:var(--a);color:var(--a);background:transparent}
.btn--ghost:hover{background:var(--a);color:#fff}
.btn--wa{background:#1FA855;color:#fff}
.btn--wa:hover{background:#17803f}
:focus-visible{outline:3px solid var(--marigold);outline-offset:3px;border-radius:4px}

/* ============ HEADER ============ */
.topbar{background:var(--teal-deep);color:#CFE6E0;font-size:.86rem;padding:7px 0}
.topbar .wrap{display:flex;gap:6px 18px;flex-wrap:wrap;justify-content:space-between;align-items:center;max-width:var(--nav-wrap)}
.topbar a{color:#fff;text-decoration:none;font-weight:600;white-space:nowrap}
.nav{
  position:sticky;top:env(safe-area-inset-top,0px);z-index:60;
  background:rgba(255,255,255,.95);backdrop-filter:blur(10px);
  border-bottom:1px solid var(--line);
}
.nav__in{display:flex;align-items:center;gap:16px;min-height:var(--navh);max-width:var(--nav-wrap)}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none;color:var(--ink);margin-right:auto;flex:none}
.brand__mark{
  width:44px;height:44px;border-radius:12px;flex:none;
  background:#fff;border:1px solid var(--line);
  display:grid;place-items:center;overflow:hidden;
}
.brand__mark img{width:100%;height:100%;object-fit:contain}
.brand__name{font-family:var(--f-display);font-weight:600;font-size:1.06rem;line-height:1.15;display:block}
.brand__sub{font-size:.74rem;color:var(--ink-soft);letter-spacing:.05em;display:block}
.nav__links{display:flex;gap:2px;align-items:center;flex:none}
.nav__links a{
  text-decoration:none;color:var(--ink);font-weight:500;font-size:.9rem;
  padding:.5em .6em;border-radius:8px;
}
.nav__links a:hover{background:var(--paper);color:var(--teal-deep)}
.nav__cta{margin-left:8px;flex:none;font-size:.92rem;padding:.7em 1.2em}
/* Desktop header never wraps text. It either fits, tightens, or switches to the menu button.
   The script right after </header> picks the level by measuring, so it also copes with edited labels. */
.brand__name,.brand__sub,.nav__links a,.nav__cta{white-space:nowrap}
.burger{display:none;background:none;border:1.5px solid var(--line);border-radius:10px;padding:9px 11px;cursor:pointer;flex:none}
.burger span{display:block;width:20px;height:2px;background:var(--ink);margin:4px 0;border-radius:2px}

/* header fit levels — class is set by the script after </header> */
.nav.is-tight .nav__in{gap:12px}
.nav.is-tight .brand__sub{display:none}
.nav.is-tight .nav__links a{font-size:.86rem;padding:.45em .5em}
.nav.is-tight .nav__cta{font-size:.88rem;padding:.6em 1.05em;margin-left:4px}
.nav.is-compact .nav__in{gap:12px}
.nav.is-compact .brand{flex:0 1 auto;min-width:0}
.nav.is-compact .brand__name,.nav.is-compact .brand__sub{white-space:normal}
.nav.is-compact .nav__links{
  display:none;position:absolute;left:0;right:0;top:100%;background:#fff;
  flex-direction:column;align-items:stretch;padding:10px;gap:2px;
  border-bottom:1px solid var(--line);box-shadow:0 12px 22px rgba(0,0,0,.08);
  max-height:calc(100vh - var(--navh) - 40px);overflow:auto;
}
.nav.is-compact .nav__links.open{display:flex}
.nav.is-compact .nav__links a{padding:.75em .8em;font-size:1rem}
.nav.is-compact .burger{display:block}

/* ============ HERO ============ */
.hero{padding:64px 0 34px;position:relative;overflow:hidden}
.hero__grid{display:grid;grid-template-columns:1.08fr .92fr;gap:54px;align-items:center}
.hero h1{margin-bottom:.35em}
.hero__sub{font-size:1.14rem;color:var(--ink-soft);max-width:38ch;margin-bottom:1.4em}
.hero__actions{display:flex;gap:12px;flex-wrap:wrap}
.hero__stack{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.portrait{
  background:var(--card);border-radius:var(--r-md);overflow:hidden;
  border:1px solid var(--line);border-top:4px solid var(--a);
}
.portrait img{aspect-ratio:3/4;object-fit:cover;object-position:50% 20%;width:100%;background:#E7EFEC}
.portrait__cap{padding:10px 11px}
.portrait__cap b{display:block;font-size:.85rem;line-height:1.25}
.portrait__cap span{font-size:.73rem;color:var(--ink-soft);display:block;margin-top:2px;line-height:1.3}
.hero__intro{margin-top:44px;padding-top:30px;border-top:1px solid var(--line);columns:2;column-gap:46px}
.hero__intro p{max-width:none;color:var(--ink-soft)}
.building{
  margin-top:40px;border-radius:var(--r-lg);overflow:hidden;border:1px solid var(--line);
  position:relative;background:#E7EFEC;
}
.building img{width:100%;aspect-ratio:16/9;object-fit:cover}
.building__cap{
  position:absolute;left:0;right:0;bottom:0;
  background:linear-gradient(0deg,rgba(10,30,26,.75),rgba(10,30,26,0));
  color:#fff;padding:34px 20px 14px;font-size:.94rem;font-weight:600;
}

/* ============ HIGHLIGHT STRIP ============ */
.strip{background:var(--teal-deep);color:#fff;padding:34px 0}
.strip ul{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:18px 26px}
.strip li{display:flex;gap:11px;font-size:.93rem;line-height:1.4;color:#DCEDE9;align-items:flex-start}
.strip li::before{
  content:"";flex:none;width:9px;height:9px;margin-top:7px;border-radius:2px;
  background:var(--marigold);transform:rotate(45deg);
}

/* ============ DOCTOR CARDS ROW ============ */
.trio{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.dcard{
  background:var(--card);border:1px solid var(--line);border-radius:var(--r-lg);
  padding:26px 24px 24px;display:flex;flex-direction:column;
  border-top:5px solid var(--a);
}
.dcard h3{margin-bottom:.15em}
.dcard__role{color:var(--a);font-weight:700;font-size:.9rem;margin-bottom:14px}
.tags{list-style:none;margin:0 0 20px;padding:0;display:flex;flex-wrap:wrap;gap:7px}
.tags li{
  font-size:.79rem;background:var(--paper);border:1px solid var(--line);
  padding:.32em .7em;border-radius:999px;color:var(--ink-soft);
}
.dcard .btn{margin-top:auto;align-self:flex-start}

/* ============ SECTION HEADINGS ============ */
.shead{max-width:68ch;margin-bottom:38px}
.shead h2{margin-bottom:.3em}
.rule{width:54px;height:4px;background:var(--a);border-radius:2px;margin-bottom:22px}

/* ============ DOCTOR PROFILE ============ */
.profile{padding:78px 0;border-top:1px solid var(--line)}
.profile__grid{display:grid;grid-template-columns:330px minmax(0,1fr);gap:46px;align-items:start}
.profile__aside{position:sticky;top:calc(var(--navh) + 24px)}
.profile__photo{border-radius:var(--r-lg);overflow:hidden;border:1px solid var(--line);background:var(--card)}
.profile__photo img{aspect-ratio:4/5;object-fit:cover;object-position:50% 18%;width:100%;background:#E7EFEC}
.factbox{background:var(--card);border:1px solid var(--line);border-radius:var(--r-md);margin-top:16px;padding:18px 20px}
.factbox dl{margin:0;display:grid;grid-template-columns:auto minmax(0,1fr);gap:6px 14px;font-size:.9rem}
.factbox dt{color:var(--ink-soft)}
.factbox dd{margin:0;font-weight:600}
.profile__name{margin-bottom:.1em}
.profile__role{color:var(--a);font-weight:700;margin-bottom:1.2em;font-size:1.02rem}
.qual{list-style:none;padding:0;margin:0 0 30px;border-left:3px solid var(--a);padding-left:18px}
.qual li{margin-bottom:8px;font-size:.96rem}
.qual li b{font-weight:700}
.block{margin-bottom:34px}
.block h4{color:var(--ink);margin-bottom:14px;font-size:1.08rem;font-family:var(--f-display);font-weight:600}
.checklist{list-style:none;margin:0;padding:0;display:grid;gap:9px}
.checklist li{position:relative;padding-left:27px;font-size:.97rem;color:var(--ink-soft)}
.checklist li::before{
  content:"";position:absolute;left:0;top:.42em;width:15px;height:15px;border-radius:50%;
  background:var(--a);opacity:.16;
}
.checklist li::after{
  content:"";position:absolute;left:4.5px;top:.66em;width:6px;height:3px;
  border-left:2px solid var(--a);border-bottom:2px solid var(--a);transform:rotate(-45deg);
}
.checklist li strong{color:var(--ink);font-weight:700}
.subgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}
.subcard{background:var(--card);border:1px solid var(--line);border-radius:var(--r-md);padding:20px 22px}
.subcard h4{color:var(--a)}

/* ============ SERVICES ============ */
.svc{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
.svc__col{
  background:var(--card);border:1px solid var(--line);border-radius:var(--r-lg);
  padding:26px 26px 24px;border-left:5px solid var(--a);
}
.svc__col h3{font-size:1.22rem;margin-bottom:.55em}
.svc__col ul{margin:0;padding-left:19px;color:var(--ink-soft);font-size:.96rem}
.svc__col li{margin-bottom:6px}

/* ============ AYUSHMAN ============ */
.ayush{background:#0A5249;color:#fff}
.ayush h2,.ayush h4{color:#fff}
.ayush .rule{background:var(--marigold)}
.ayush__grid{display:grid;grid-template-columns:1.05fr .95fr;gap:52px;align-items:start}
.ayush p{color:#CFE4DF}
.badge{
  display:inline-flex;align-items:center;gap:10px;background:rgba(255,255,255,.1);
  border:1px solid rgba(255,255,255,.22);border-radius:999px;padding:.5em 1.1em;
  font-weight:600;font-size:.9rem;margin-bottom:20px;color:#fff;
}
.badge i{width:9px;height:9px;background:var(--marigold);border-radius:50%;display:block;flex:none}
.facil{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 22px}
.facil li{font-size:.94rem;color:#DCEDE9;padding-left:20px;position:relative}
.facil li::before{content:"";position:absolute;left:0;top:.62em;width:8px;height:8px;border-radius:50%;background:var(--marigold)}

/* ============ GALLERY ============ */
.gal{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
.gal figure{margin:0;border-radius:var(--r-md);overflow:hidden;background:var(--card);border:1px solid var(--line);position:relative}
.gal img{aspect-ratio:4/3;object-fit:cover;width:100%;background:#E7EFEC;cursor:zoom-in}
.gal figcaption{padding:10px 13px;font-size:.85rem;color:var(--ink-soft)}
.vids{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin-top:26px}
.vid{aspect-ratio:16/9;border-radius:var(--r-md);overflow:hidden;border:1px solid var(--line);background:#DDE7E4}
.vid iframe{width:100%;height:100%;border:0;display:block}
.vid--empty{background:linear-gradient(135deg,#E4EDEA,#D3E2DE)}
.vid__empty{width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;text-align:center;padding:16px;color:var(--ink-soft);font-size:.86rem}
.vid__empty b{font-family:var(--f-display);font-weight:600;font-size:1rem;color:var(--ink)}
.vid__play{width:54px;height:54px;border-radius:50%;background:var(--a);position:relative;margin-bottom:8px}
.vid__play::after{content:"";position:absolute;left:21px;top:15px;border-left:17px solid #fff;border-top:12px solid transparent;border-bottom:12px solid transparent}

/* ============ REVIEWS ============ */
.revs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
.rev{background:var(--card);border:1px solid var(--line);border-radius:var(--r-lg);padding:24px;margin:0}
.stars{color:var(--marigold);letter-spacing:3px;font-size:1.05rem;margin-bottom:10px}
.rev p{font-family:var(--f-display);font-size:1.02rem;line-height:1.5;color:var(--ink)}
.rev cite{font-style:normal;font-size:.87rem;color:var(--ink-soft);font-weight:600}
/* Google-style review card */
.rev{display:flex;flex-direction:column}
.rev__top{display:flex;align-items:center;gap:12px;margin-bottom:12px}
.rev__av{width:42px;height:42px;border-radius:50%;background:var(--a);color:#2A1C00;flex:none;display:grid;place-items:center;font-weight:700;font-size:1.05rem}
.rev__who{min-width:0}
.rev__who cite{display:block;font-size:.98rem;color:var(--ink);font-weight:700;line-height:1.25}
.rev__who cite a{color:inherit;text-decoration:none}
.rev__who cite a:hover{text-decoration:underline}
.rev__meta{display:block;font-size:.8rem;color:var(--ink-soft);margin-top:1px}
.rev .stars{margin-bottom:8px}
.rev p{margin-bottom:0}
.rev-summary{margin:14px 0 0;font-weight:600;color:var(--ink)}
.rev-summary .stars{display:inline;margin:0 6px 0 0}
.rev-summary small{font-weight:500;color:var(--ink-soft);font-size:.85rem}

/* ============ CONTACT ============ */
.cgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:46px;align-items:start}
.info{display:grid;gap:18px;margin-bottom:26px}
.info div b{display:block;font-size:.8rem;color:var(--ink-soft);font-weight:600;margin-bottom:2px}
.info div span,.info div a{font-size:1.02rem;font-weight:600;color:var(--ink);text-decoration:none;overflow-wrap:anywhere}
.tablewrap{overflow-x:auto;-webkit-overflow-scrolling:touch}
.tt{width:100%;border-collapse:collapse;font-size:.93rem;background:var(--card);border-radius:var(--r-md);overflow:hidden;border:1px solid var(--line)}
.tt th,.tt td{text-align:left;padding:11px 14px;border-bottom:1px solid var(--line)}
.tt th{background:var(--paper);font-weight:700;font-size:.82rem;color:var(--ink-soft)}
.tt tr:last-child td{border-bottom:0}
.form{background:var(--card);border:1px solid var(--line);border-radius:var(--r-lg);padding:28px}
.field{margin-bottom:16px}
.field label{display:block;font-size:.86rem;font-weight:600;margin-bottom:6px}
.field input,.field select,.field textarea{
  width:100%;font-family:var(--f-body);font-size:16px;padding:.72em .85em;
  border:1.5px solid var(--line);border-radius:var(--r-sm);background:#FCFDFD;color:var(--ink);
}
.field textarea{min-height:110px;resize:vertical}
.map{margin-top:26px;border-radius:var(--r-lg);overflow:hidden;border:1px solid var(--line);height:320px;background:#E7EFEC}
.map iframe{width:100%;height:100%;border:0;display:block}
.maplinks{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}

/* ============ FOOTER ============ */
.foot{background:var(--ink);color:#B9CFC9;padding:48px 0 30px;font-size:.92rem}
.foot__grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:38px;margin-bottom:34px}
.foot h4{color:#fff;margin-bottom:12px}
.foot a{color:#B9CFC9;text-decoration:none;overflow-wrap:anywhere}
.foot a:hover{color:#fff}
.foot ul{list-style:none;padding:0;margin:0;display:grid;gap:7px}
.foot__bot{border-top:1px solid rgba(255,255,255,.14);padding-top:18px;display:flex;justify-content:space-between;gap:10px 16px;flex-wrap:wrap;font-size:.84rem;align-items:center}
.editlink{background:none;border:0;color:#7E9A94;font:inherit;cursor:pointer;text-decoration:underline;padding:4px 0}

/* ============ WHATSAPP FLOAT ============ */
.wafloat{
  position:fixed;right:16px;bottom:calc(16px + env(safe-area-inset-bottom,0px));z-index:70;
  background:#1FA855;color:#fff;width:56px;height:56px;border-radius:50%;
  display:grid;place-items:center;box-shadow:0 8px 22px rgba(0,0,0,.22);text-decoration:none;
}
.wafloat svg{width:28px;height:28px;fill:#fff}
body.editing .wafloat{bottom:calc(84px + env(safe-area-inset-bottom,0px))}
body.dash-open .wafloat{display:none}

/* ============ INLINE EDIT UI ============ */
.editbar{
  position:fixed;left:0;right:0;bottom:0;z-index:200;background:var(--ink);color:#fff;
  padding:10px 16px calc(10px + env(safe-area-inset-bottom,0px));
  display:none;gap:8px;align-items:center;flex-wrap:wrap;
  box-shadow:0 -6px 22px rgba(0,0,0,.2);font-size:.9rem;
}
body.editing .editbar{display:flex}
.editbar strong{font-family:var(--f-display);font-size:1rem;margin-right:auto}
.ebtn{
  background:rgba(255,255,255,.14);color:#fff;border:1px solid rgba(255,255,255,.25);
  border-radius:8px;padding:.5em 1em;font:inherit;font-weight:600;cursor:pointer;
}
.ebtn:hover{background:rgba(255,255,255,.26)}
.ebtn--go{background:var(--marigold);border-color:var(--marigold);color:#2A1C00}
.ebtn--go:hover{background:#f0ab3c}
body.editing{padding-bottom:78px}
body.editing [contenteditable="true"]{
  outline:1px dashed rgba(14,111,99,.55);outline-offset:3px;border-radius:3px;min-height:1em;
}
body.editing [contenteditable="true"]:focus{outline:2px solid var(--teal);background:rgba(227,155,43,.09)}
body.editing [data-img]{cursor:copy;box-shadow:inset 0 0 0 3px rgba(227,155,43,.75)}
.editonly{display:none}
body.editing .editonly{display:inline-flex}
.xbtn{
  position:absolute;top:6px;right:6px;z-index:5;width:28px;height:28px;border-radius:50%;
  background:#C0392B;color:#fff;border:0;cursor:pointer;font-size:16px;line-height:1;
  align-items:center;justify-content:center;
}
.addbtn{
  margin-top:12px;background:var(--teal);color:#fff;border:0;border-radius:8px;
  padding:.45em 1em;font:inherit;font-size:.85rem;font-weight:600;cursor:pointer;
}
.repeat{position:relative}
body.editing .repeat{outline:1px dotted rgba(0,0,0,.18);outline-offset:4px}
.toast{
  position:fixed;left:50%;transform:translateX(-50%);
  bottom:calc(90px + env(safe-area-inset-bottom,0px));z-index:600;
  background:var(--ink);color:#fff;padding:.7em 1.3em;border-radius:999px;font-size:.9rem;
  opacity:0;pointer-events:none;transition:opacity .25s;max-width:calc(100vw - 32px);text-align:center;
}
.toast.show{opacity:1}
</style>
<style>
/* ======================================================================
   ADMIN DASHBOARD
   ====================================================================== */
.dash{
  position:fixed;inset:0;z-index:400;background:var(--paper);
  display:none;flex-direction:column;
  font-family:var(--f-body);color:var(--ink);
}
body.dash-open{overflow:hidden}
body.dash-open .dash{display:flex}
.dash__top{
  background:var(--ink);color:#fff;flex:none;
  padding:calc(12px + env(safe-area-inset-top,0px)) var(--gut) 12px;
  display:flex;align-items:center;gap:12px;
}
.dash__logo{width:34px;height:34px;border-radius:9px;background:#fff;overflow:hidden;flex:none}
.dash__logo img{width:100%;height:100%;object-fit:contain}
.dash__title{font-family:var(--f-display);font-size:1.05rem;font-weight:600;line-height:1.2;margin-right:auto;min-width:0}
.dash__title small{display:block;font-family:var(--f-body);font-size:.74rem;color:#9DB8B1;font-weight:500}
.dash__close{
  background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.25);color:#fff;
  border-radius:9px;padding:.5em 1em;font:inherit;font-weight:600;cursor:pointer;flex:none;
}
.dash__close:hover{background:rgba(255,255,255,.26)}
.dash__main{flex:1;min-height:0;display:grid;grid-template-columns:232px minmax(0,1fr)}
.dash__side{
  background:#fff;border-right:1px solid var(--line);padding:16px 12px;
  overflow:auto;display:flex;flex-direction:column;gap:3px;
}
.dtab{
  display:flex;align-items:center;gap:10px;width:100%;text-align:left;
  background:none;border:0;border-radius:10px;padding:.68em .9em;
  font:inherit;font-size:.94rem;font-weight:600;color:var(--ink-soft);cursor:pointer;white-space:nowrap;
}
.dtab:hover{background:var(--paper);color:var(--ink)}
.dtab[aria-selected="true"]{background:var(--teal-deep);color:#fff}
.dtab i{width:8px;height:8px;border-radius:2px;background:currentColor;opacity:.55;flex:none;transform:rotate(45deg)}
.dash__content{overflow:auto;padding:26px var(--gut) 80px;-webkit-overflow-scrolling:touch}
.dpanel{display:none;max-width:860px}
.dpanel[data-open]{display:block}
.dpanel h2{font-size:1.5rem;margin-bottom:.25em}
.dpanel>p.lede{margin-bottom:26px}
.dsec{background:#fff;border:1px solid var(--line);border-radius:var(--r-md);padding:20px;margin-bottom:18px}
.dsec h3{font-size:1.08rem;font-family:var(--f-body);font-weight:700;margin-bottom:.5em}
.dsec p{font-size:.93rem;color:var(--ink-soft);max-width:60ch}
.dstats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:18px}
.dstat{background:#fff;border:1px solid var(--line);border-radius:var(--r-md);padding:16px 18px}
.dstat b{display:block;font-family:var(--f-display);font-size:1.9rem;line-height:1;color:var(--teal-deep)}
.dstat span{font-size:.84rem;color:var(--ink-soft);display:block;margin-top:6px}
.dactions{display:flex;flex-wrap:wrap;gap:10px}
.dbtn{
  display:inline-flex;align-items:center;justify-content:center;gap:.45em;
  background:var(--teal-deep);color:#fff;border:1.5px solid var(--teal-deep);
  border-radius:9px;padding:.62em 1.1em;font:inherit;font-size:.92rem;font-weight:600;
  cursor:pointer;text-decoration:none;white-space:normal;text-align:center;
}
.dbtn:hover{background:var(--ink);border-color:var(--ink)}
.dbtn--quiet{background:#fff;color:var(--teal-deep)}
.dbtn--quiet:hover{background:var(--paper);color:var(--ink)}
.dbtn--warn{background:#fff;color:#A83226;border-color:#E2BAB4}
.dbtn--warn:hover{background:#A83226;color:#fff;border-color:#A83226}
.dbtn--go{background:var(--marigold);border-color:var(--marigold);color:#2A1C00}
.dbtn--go:hover{background:#f0ab3c;border-color:#f0ab3c;color:#2A1C00}
.dfield{margin-bottom:14px}
.dfield label{display:block;font-size:.86rem;font-weight:700;margin-bottom:5px}
.dfield .hint{font-size:.81rem;color:var(--ink-soft);font-weight:500;margin-top:5px;display:block}
.dfield input,.dfield textarea,.dfield select{
  width:100%;font-family:var(--f-body);font-size:16px;padding:.62em .8em;
  border:1.5px solid var(--line);border-radius:var(--r-sm);background:#FCFDFD;color:var(--ink);
}
.dfield textarea{min-height:76px;resize:vertical}
.dgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(168px,1fr));gap:14px}
.dimg{border:1px solid var(--line);border-radius:var(--r-md);background:#fff;overflow:hidden;display:flex;flex-direction:column}
.dimg__thumb{aspect-ratio:4/3;background:#E7EFEC;width:100%;object-fit:cover}
.dimg__b{padding:10px 12px 12px;display:flex;flex-direction:column;gap:8px;flex:1}
.dimg__name{font-size:.85rem;font-weight:700;line-height:1.25}
.dimg__row{display:flex;gap:6px;margin-top:auto;flex-wrap:wrap}
.dimg__row button{
  flex:1 1 auto;font:inherit;font-size:.8rem;font-weight:600;cursor:pointer;
  border:1.5px solid var(--line);background:#fff;color:var(--teal-deep);border-radius:7px;padding:.42em .5em;
}
.dimg__row button:hover{background:var(--paper)}
.drow{
  display:grid;grid-template-columns:104px minmax(0,1fr);gap:14px;align-items:start;
  border:1px solid var(--line);border-radius:var(--r-md);background:#fff;padding:12px;margin-bottom:12px;
}
.drow img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:8px;background:#E7EFEC}
.drow .dfield{margin-bottom:8px}
.revrow{border:1px solid var(--line);border-radius:var(--r-md);background:#fff;padding:14px;margin-bottom:12px}
.revrow label{display:block;font-size:.86rem;font-weight:700;margin-bottom:10px}
.revrow label input,.revrow label select,.revrow label textarea{
  display:block;margin-top:5px;font-weight:400;width:100%;font-family:var(--f-body);font-size:16px;padding:.62em .8em;
  border:1.5px solid var(--line);border-radius:var(--r-sm);background:#FCFDFD;color:var(--ink);
}
.revrow label select{width:auto;min-width:90px}
.revrow textarea{min-height:90px;resize:vertical}
.dnote{
  background:#FFF8EA;border:1px solid #F0DCB4;border-radius:var(--r-md);
  padding:14px 16px;font-size:.89rem;color:#6B5218;margin-bottom:18px;
}
.dnote b{color:#4A3808}
.dlogin{flex:1;display:grid;place-items:center;padding:30px var(--gut)}
.dlogin__box{background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);padding:28px;width:100%;max-width:380px}
.dlogin__box h2{font-size:1.3rem;margin-bottom:.2em}
.dlogin__box p{font-size:.9rem;color:var(--ink-soft);margin-bottom:18px}
.dmsg{font-size:.86rem;color:#A83226;font-weight:600;min-height:1.2em;margin-top:8px}
.dash[data-locked] .dash__main{display:none}
.dash:not([data-locked]) .dlogin{display:none}

/* ============ RESPONSIVE ============ */
@media (max-width:1040px){
  .strip ul{grid-template-columns:repeat(2,minmax(0,1fr))}
  .gal{grid-template-columns:repeat(3,minmax(0,1fr))}
  .hero__grid{grid-template-columns:1fr;gap:30px}
  .hero__stack{max-width:700px}
}
@media (max-width:900px){
  :root{--navh:64px}
  .nav__cta{display:none}
  .hero{padding:44px 0 28px}
  .hero__grid{grid-template-columns:1fr;gap:30px}
  .hero__intro{columns:1;margin-top:34px;padding-top:24px}
  .trio{grid-template-columns:1fr}
  .profile__grid{grid-template-columns:1fr;gap:26px}
  .profile__aside{
    position:static;max-width:none;
    display:grid;grid-template-columns:minmax(0,210px) minmax(0,1fr);gap:18px;align-items:start;
  }
  .profile__aside .factbox{margin-top:0}
  .subgrid,.svc,.ayush__grid,.cgrid{grid-template-columns:1fr;gap:24px}
  .revs{grid-template-columns:1fr}
  .vids{grid-template-columns:1fr}
  .foot__grid{grid-template-columns:1fr;gap:26px}
  .section,.profile{padding:54px 0}
  /* dashboard: side nav becomes a scrolling tab strip */
  .dash__main{grid-template-columns:1fr;grid-template-rows:auto minmax(0,1fr)}
  .dash__side{
    flex-direction:row;border-right:0;border-bottom:1px solid var(--line);
    overflow-x:auto;overflow-y:hidden;padding:10px var(--gut);gap:6px;
  }
  .dtab{width:auto;flex:none;padding:.55em .9em;font-size:.88rem}
  .dash__content{padding:20px var(--gut) 70px}
}
@media (max-width:620px){
  :root{--gut:16px}
  body{font-size:16px}
  .section,.profile{padding:44px 0}
  .shead{margin-bottom:28px}
  .topbar{font-size:.8rem}
  .topbar .wrap{justify-content:center;text-align:center;gap:2px 14px}
  /* portraits become horizontal rows — no cropped faces, no squeezed captions */
  .hero__stack{grid-template-columns:1fr;gap:10px}
  .portrait{
    display:grid;grid-template-columns:92px minmax(0,1fr);align-items:center;
    border-top:1px solid var(--line);border-left:4px solid var(--a);border-radius:var(--r-md);
  }
  .portrait img{aspect-ratio:1/1;height:100%}
  .portrait__cap{padding:10px 14px}
  .portrait__cap b{font-size:.95rem}
  .portrait__cap span{font-size:.8rem}
  .building{margin-top:28px}
  .building img{aspect-ratio:4/3}
  .building__cap{font-size:.85rem;padding:28px 16px 12px}
  .hero__actions{gap:10px}
  .hero__actions .btn{flex:1 1 200px}
  .strip{padding:26px 0}
  .strip ul{grid-template-columns:1fr;gap:12px}
  .dcard{padding:20px 18px}
  .svc__col{padding:20px 18px;border-left-width:4px}
  .rev{padding:20px 18px}
  .form{padding:20px 18px}
  .subcard{padding:16px 18px}
  .factbox{padding:15px 16px}
  .qual{padding-left:14px}
  .profile__aside{grid-template-columns:1fr;gap:14px}
  .profile__photo{max-width:270px}
  .gal{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
  .gal figcaption{padding:8px 10px;font-size:.78rem}
  .facil{grid-template-columns:1fr}
  .map{height:260px;margin-top:20px}
  .maplinks .btn{flex:1 1 180px}
  .foot{padding:38px 0 26px}
  .editbar{font-size:.84rem;gap:6px}
  .editbar strong{width:100%;margin:0 0 2px}
  .ebtn{flex:1 1 auto;padding:.55em .7em;font-size:.84rem}
  /* OPD table stacks into readable cards instead of scrolling sideways */
  .tablewrap{overflow:visible}
  .tt{display:block;border-radius:var(--r-md)}
  .tt thead{display:none}
  .tt tbody,.tt tr,.tt td{display:block;width:100%}
  .tt tr{border-bottom:1px solid var(--line);padding:12px 14px}
  .tt tr:last-child{border-bottom:0}
  .tt td{border:0;padding:0}
  .tt td:first-child{font-weight:700;margin-bottom:6px;font-size:.95rem}
  .tt td[data-l]{display:flex;justify-content:space-between;gap:14px;font-size:.88rem;padding:2px 0}
  .tt td[data-l]::before{content:attr(data-l);color:var(--ink-soft);font-weight:600}
  .wafloat{width:52px;height:52px;right:14px}
  .wafloat svg{width:26px;height:26px}
  .dgrid{grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:10px}
  .drow{grid-template-columns:84px minmax(0,1fr);gap:10px;padding:10px}
  .dsec{padding:16px}
}
@media (max-width:400px){
  .brand__sub{display:none}
  .brand__mark{width:38px;height:38px}
  .brand__name{font-size:.97rem}
  .hero__actions .btn{flex:1 1 100%}
  .dactions .dbtn{flex:1 1 100%}
  .drow{grid-template-columns:1fr}
  .drow img{max-width:180px}
}
@media (prefers-reduced-motion:reduce){
  *{animation:none!important;transition:none!important}
  html{scroll-behavior:auto}
}
@media print{
  .nav,.topbar,.wafloat,.editbar,.form,.dash,.maplinks,.map{display:none!important}
}
</style>
</head>
<body class="<%= isAdminPage ? 'dash-open' : '' %>">
<!-- ================= TOP BAR ================= -->
<div class="topbar" data-region="topbar"><%- regions["topbar"] %></div>
<!-- ================= NAV ================= -->
<header class="nav">
<div class="wrap nav__in" data-region="nav"><%- regions["nav"] %></div>
</header>

<main id="top">
<!-- ================= HERO ================= -->
<section class="hero">
<div class="wrap" data-region="hero"><%- regions["hero"] %></div>
</section>
<!-- ================= HIGHLIGHTS ================= -->
<section class="strip">
<div class="wrap" data-region="strip"><%- regions["strip"] %></div>
</section>
<!-- ================= THREE DOCTORS ================= -->
<section class="section" id="doctors">
<div class="wrap" data-region="doctors"><%- regions["doctors"] %></div>
</section>
<!-- ================= PROFILE 1: ORTHO ================= -->
<section class="profile" id="ortho" style="--a:var(--teal)">
<div class="wrap" data-region="ortho"><%- regions["ortho"] %></div>
</section>
<!-- ================= PROFILE 2: GYNAE ================= -->
<section class="profile" id="gynae" style="--a:var(--rose)">
<div class="wrap" data-region="gynae"><%- regions["gynae"] %></div>
</section>
<!-- ================= PROFILE 3: PHYSIO ================= -->
<section class="profile" id="physio" style="--a:var(--marigold)">
<div class="wrap" data-region="physio"><%- regions["physio"] %></div>
</section>
<!-- ================= SERVICES ================= -->
<section class="section" id="services" style="--a:var(--teal)">
<div class="wrap" data-region="services"><%- regions["services"] %></div>
</section>
<!-- ================= AYUSHMAN ================= -->
<section class="section ayush" id="ayushman">
<div class="wrap" data-region="ayushman"><%- regions["ayushman"] %></div>
</section>
<!-- ================= GALLERY ================= -->
<section class="section" id="gallery" style="--a:var(--teal)">
<div class="wrap" data-region="gallery"><%- regions["gallery"] %></div>
</section>
<!-- ================= REVIEWS ================= -->
<section class="section" id="reviews" style="--a:var(--marigold)">
<div class="wrap" data-region="reviews"><%- regions["reviews"] %></div>
</section>
<!-- ================= CONTACT ================= -->
<section class="section" id="contact" style="--a:var(--teal)">
<div class="wrap" data-region="contact"><%- regions["contact"] %></div>
</section>
</main>
<!-- ================= FOOTER ================= -->
<footer class="foot">
<div class="wrap" data-region="footer"><%- regions["footer"] %></div>
</footer>
<a aria-label="Chat on WhatsApp" class="wafloat" data-wa="" href="https://wa.me/917224982249" rel="noopener" target="_blank">
<svg aria-hidden="true" viewbox="0 0 24 24"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 004.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2zm0 18.15h-.01a8.2 8.2 0 01-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 01-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.83 2.41a8.18 8.18 0 012.41 5.83c0 4.54-3.7 8.23-8.24 8.23zm4.52-6.16c-.25-.13-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.54.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.38.11-.5.11-.11.25-.29.37-.44.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.02 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.16-.48-.29z"></path></svg>
</a>
<div class="editbar" id="editbar">
<strong>Editing the page</strong>
<button class="ebtn" id="btnAdd" type="button">Show add / remove</button>
<button class="ebtn ebtn--go" id="btnBackToDash" type="button">Back to dashboard</button>
<button class="ebtn" id="btnDone" type="button">Done</button>
</div>
<div aria-live="polite" class="toast" id="toast" role="status"></div>
<!-- ======================================================================
     ADMIN DASHBOARD  (not part of the public page — opens over the top)
     ====================================================================== -->
<div class="dash" <%= isAuthed ? "" : "data-locked" %> id="dash" role="dialog" aria-modal="true" aria-label="Site dashboard">
<div class="dash__top">
<span class="dash__logo"><img alt="" src="data:image/jpeg;base64,"/></span>
<span class="dash__title">Site dashboard<small>Dr Dixit Bilaspur Hospital</small></span>
<button class="dash__close" id="dashLogout" type="button">Log out</button><button class="dash__close" id="dashClose" type="button">Close</button>
</div>
<div class="dlogin">
<div class="dlogin__box">
<h2>Sign in</h2>
<p>Sign in to manage photos, video links, contact details, the map and other site content.</p>
<div class="dfield">
<label for="duser">Username</label>
<input autocomplete="username" id="duser" placeholder="Admin username" type="text"/>
</div>
<div class="dfield">
<label for="dpw">Password</label>
<input autocomplete="current-password" id="dpw" placeholder="Admin password" type="password"/>
</div>
<button class="dbtn" id="dpwGo" style="width:100%" type="button">Sign in</button>
<div class="dmsg" id="dpwMsg"></div>
</div>
</div>
<div class="dash__main">
<div aria-label="Dashboard sections" class="dash__side" role="tablist">
<button aria-selected="true" class="dtab" data-tab="home" role="tab" type="button"><i></i>Overview</button>
<button aria-selected="false" class="dtab" data-tab="analytics" role="tab" type="button"><i></i>Analytics</button>
<button aria-selected="false" class="dtab" data-tab="pics" role="tab" type="button"><i></i>Photos</button>
<button aria-selected="false" class="dtab" data-tab="gallery" role="tab" type="button"><i></i>Photo cards</button>
<button aria-selected="false" class="dtab" data-tab="contact" role="tab" type="button"><i></i>Contact &amp; map</button>
<button aria-selected="false" class="dtab" data-tab="reviews" role="tab" type="button"><i></i>Reviews</button>
<button aria-selected="false" class="dtab" data-tab="videos" role="tab" type="button"><i></i>Videos</button>
<button aria-selected="false" class="dtab" data-tab="text" role="tab" type="button"><i></i>Page text</button>
<button aria-selected="false" class="dtab" data-tab="publish" role="tab" type="button"><i></i>Save &amp; publish</button>
</div>
<div class="dash__content">
<!-- ---------- OVERVIEW ---------- -->
<section class="dpanel" data-open="" data-panel="home">
<h2>Overview</h2>
<p class="lede">Everything you change here is saved in this browser straight away. When you are happy, download the updated website and give that one file to whoever hosts the site.</p>
<div class="dstats">
<div class="dstat"><b id="statPics">0</b><span>pictures on the site</span></div>
<div class="dstat"><b id="statGal">0</b><span>gallery pictures</span></div>
<div class="dstat"><b id="statVid">0</b><span>videos added</span></div>
<div class="dstat"><b id="statSaved">—</b><span>changes saved</span></div>
</div>
<div class="dsec">
<h3>Jump straight to</h3>
<div class="dactions">
<button class="dbtn" data-goto="pics" type="button">Replace a picture</button>
<button class="dbtn dbtn--quiet" data-goto="contact" type="button">Fix the map or phone number</button>
<button class="dbtn dbtn--quiet" id="goEdit" type="button">Edit text on the page</button>
<button class="dbtn dbtn--go" data-goto="publish" type="button">Download the website</button>
</div>
</div>
<div class="dsec">
<h3>How this works</h3>
<p>The public site loads its content from one JSON file. Dashboard changes are sent to the server, saved to that JSON file, and are visible to visitors immediately.</p>
</div>
</section>
<!-- ---------- ANALYTICS ---------- -->
<section class="dpanel" data-panel="analytics">
<h2>Analytics</h2>
<p class="lede">Simple site-wide visit numbers collected by the server.</p>
<div class="dstats">
<div class="dstat"><b id="statVisits">0</b><span>total visits</span></div>
<div class="dstat"><b id="statToday">0</b><span>visits today</span></div>
<div class="dstat"><b id="stat7d">0</b><span>visits in 7 days</span></div>
<div class="dstat"><b id="statLastVisit">—</b><span>last visit</span></div>
</div>
<div class="dnote"><b>Note:</b> a visit is counted when the public page loads. These numbers are server-wide, not tied to one browser.</div>
</section>
<!-- ---------- PICTURES ---------- -->
<section class="dpanel" data-panel="pics">
<h2>Pictures</h2>
<p class="lede">Every picture on the site is listed here. Pick a new photo and it replaces the old one immediately — large photos are resized automatically so the site stays fast.</p>
<div class="dnote">Use landscape photos for the building and gallery, and upright photos for the doctors. Please get written consent before putting a patient's photo online.</div>
<div class="dgrid" id="picGrid"></div>
</section>
<!-- ---------- GALLERY ---------- -->
<section class="dpanel" data-panel="gallery">
<h2>Photo cards</h2>
<p class="lede">Manage the photo cards shown in the public gallery. Add a new card, choose its photo, and write the caption that visitors will see.</p>
<div id="galList"></div>
