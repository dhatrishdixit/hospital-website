</div>
<p>For stronger security, the dashboard should eventually be moved behind a server-side login rather than storing credentials in the HTML.</p>
</section></div>

</div>
</div>
<script>
/* Header fit: try the full header, then a tighter one, then the menu button — whichever
   is the first that really fits. Measured, not guessed, so fonts and edited labels are handled. */
(function(){
  var nav = document.querySelector(".nav"), row = nav && nav.querySelector(".nav__in");
  if(!row) return;
  var LEVELS = ["", "is-tight", "is-compact"], raf = 0, lastW = -1;
  function overflows(){
    var kids = [].slice.call(row.children).filter(function(k){ return k.offsetParent !== null || getComputedStyle(k).position === "fixed"; });
    if(!kids.length) return false;
    var cs = getComputedStyle(row), r = row.getBoundingClientRect();
    var limit = r.right - parseFloat(cs.paddingRight) + 0.5;
    return kids[kids.length - 1].getBoundingClientRect().right > limit;
  }
  function fit(){
    lastW = window.innerWidth;
    for(var i = 0; i < LEVELS.length; i++){
      nav.classList.remove("is-tight", "is-compact");
      if(LEVELS[i]) nav.classList.add(LEVELS[i]);
      if(i === LEVELS.length - 1 || !overflows()) break;
    }
    if(!nav.classList.contains("is-compact")){
      var l = document.getElementById("navlinks"), b = document.getElementById("burger");
      if(l) l.classList.remove("open");
      if(b) b.setAttribute("aria-expanded", "false");
    }
  }
  function queue(force){
    if(force !== true && window.innerWidth === lastW) return;   // ignore mobile address-bar height changes
    cancelAnimationFrame(raf); raf = requestAnimationFrame(fit);
  }
  fit();
  window.addEventListener("resize", function(){ queue(); });
  window.addEventListener("load", function(){ queue(true); });
  if(document.fonts && document.fonts.ready) document.fonts.ready.then(function(){ queue(true); });
  nav.addEventListener("input", function(){ queue(true); });      // menu labels edited inline
})();
</script><script>
(function(){
  "use strict";

  var SERVER_MODE = true;
  var IS_ADMIN_PAGE = <%= isAdminPage ? "true" : "false" %>;
  var serverAuthed = <%= isAuthed ? "true" : "false" %>;
  var serverReady = true;
  var serverSaveT = null;
  var serverSaveBusy = false;
  var serverSaveQueued = false;
  var CFG_DEFAULTS = <%- safeCfgJson %>; /*CFG*/

  var BUILD = document.documentElement.getAttribute("data-build") || "0";
  var lastAnalytics = {total:0, today:0, last7:0, lastVisit:""};

  function analyticsDay(d){
    return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0");
  }
  function formatVisitTime(iso){
    if(!iso) return "—";
    try{ return new Intl.DateTimeFormat(undefined,{day:"2-digit",month:"short",hour:"2-digit",minute:"2-digit"}).format(new Date(iso)); }
    catch(e){ return "—"; }
  }
  async function renderAnalytics(){
    if(!IS_ADMIN_PAGE || !serverAuthed) return;
    try{
      var r = await fetch("/api/analytics",{credentials:"same-origin",cache:"no-store"});
      if(r.ok) lastAnalytics = await r.json();
    }catch(e){}
    var a = lastAnalytics;
    if($("#statVisits")) $("#statVisits").textContent = a.total || 0;
    if($("#statToday")) $("#statToday").textContent = a.today || 0;
    if($("#stat7d")) $("#stat7d").textContent = a.last7 || 0;
    if($("#statLastVisit")) $("#statLastVisit").textContent = formatVisitTime(a.lastVisit || "");
  }

  var HOME = {lat:"22.0979596", lng:"82.1304722", cid:"15110069601122513501", name:"Bilaspur Hospital (Dr Dixit)",
    embed:"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d850!2d82.1304722!3d22.0979596!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3a280b804d8725d9%3A0xd1b1c03ee255f25d!2sBilaspur%20Hospital%20(Dr%20Dixit)!5e0!3m2!1sen!2sin!4v1789890000000!5m2!1sen!2sin"};

  var $  = function(s,c){ return (c||document).querySelector(s); };
  var $$ = function(s,c){ return Array.prototype.slice.call((c||document).querySelectorAll(s)); };
  function esc(s){ return String(s==null?"":s).replace(/[&<>"']/g,function(m){
    return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]; }); }

  /* ---------- toast ---------- */
  var toastEl = $("#toast"), toastT;
  function toast(msg){
    toastEl.textContent = msg; toastEl.classList.add("show");
    clearTimeout(toastT); toastT = setTimeout(function(){ toastEl.classList.remove("show"); }, 2600);
  }

  /* ---------- remember the shipped pictures so they can be restored ---------- */
  var DEFAULT_IMG = {};
  $$('main [data-img], header [data-img]').forEach(function(n){
    DEFAULT_IMG[n.getAttribute("data-img")] = n.getAttribute("src");
  });

  /* =====================================================
     SERVER-SIDE PERSISTENCE
     ===================================================== */
  var regions = $$('[data-region]');
  var CFG = JSON.parse(JSON.stringify(CFG_DEFAULTS));
  var savedNote = "server";

  function cleanClone(node){
    var c = node.cloneNode(true);
    $$('[contenteditable]', c).forEach(function(n){ n.removeAttribute('contenteditable'); });
    $$('.xbtn, .addbtn[data-add]', c).forEach(function(n){ n.remove(); });
    $$('[data-live]', c).forEach(function(n){ n.innerHTML = ''; });
    return c;
  }
  function stateForServer(){
    var out = {cfg: JSON.parse(JSON.stringify(CFG)), regions:{}};
    regions.forEach(function(r){ out.regions[r.getAttribute('data-region')] = cleanClone(r).innerHTML; });
    return out;
  }
  function publishToServer(){
    if(!SERVER_MODE || !serverReady || !serverAuthed) return;
    clearTimeout(serverSaveT);
    serverSaveQueued = true;
    serverSaveT = setTimeout(async function(){
      if(serverSaveBusy) return;
      serverSaveBusy = true; serverSaveQueued = false;
      try{
        var r = await fetch('/api/site',{
          method:'PUT',
          headers:{'Content-Type':'application/json'},
          credentials:'same-origin',
          body:JSON.stringify(stateForServer())
        });
        if(!r.ok){
          if(r.status === 401) serverAuthed = false;
          throw new Error('save failed');
        }
        savedNote = 'published';
        if($("#statSaved")) $("#statSaved").textContent = savedNote;
      }catch(e){
        toast(serverAuthed ? 'Could not publish to the server.' : 'Your admin session has expired. Please sign in again from /admin.');
      }finally{
        serverSaveBusy = false;
        if(serverSaveQueued) publishToServer();
      }
    }, 250);
  }
  function save(){ publishToServer(); }

  /* =====================================================
     APPLY CONFIG TO THE PAGE
     ===================================================== */
  function waHref(el){
    var t = el.getAttribute("data-wa-text");
    return "https://wa.me/" + CFG.wa + (t ? "?text=" + encodeURIComponent(t) : "");
  }
  function applyContact(){
    $$('[data-field="phone"]').forEach(function(n){
      n.textContent = CFG.phone;
      if(n.tagName === "A") n.setAttribute("href", "tel:" + CFG.dial.replace(/[^\d+]/g,""));
    });
    $$('[data-field="email"]').forEach(function(n){
      n.textContent = CFG.email;
      if(n.tagName === "A") n.setAttribute("href", "mailto:" + CFG.email);
    });
    $$('[data-field="address"]').forEach(function(n){ n.textContent = CFG.address; });
    $$("[data-wa]").forEach(function(n){ n.setAttribute("href", waHref(n)); });
    var anySocial = false;
    ["facebook","instagram","youtube"].forEach(function(k){
      if(CFG[k]) anySocial = true;
      $$('[data-social="' + k + '"]').forEach(function(n){
        n.setAttribute("href", CFG[k] || "#");
        var li = n.closest("li"); if(li) li.style.display = CFG[k] ? "" : "none";
      });
    });
    $$("[data-social-block]").forEach(function(n){ n.style.display = anySocial ? "" : "none"; });
  }
  function mapEmbed(){
    // 1) an embed the owner pasted from Google (Share > Embed a map) always wins
    if(CFG.embed) return CFG.embed;
    // 2) the hospital's own spot: Google's place embed, which draws the pin with the place name beside it
    if(CFG.lat === HOME.lat && CFG.lng === HOME.lng) return HOME.embed;
    // 3) a pin the owner moved: plain coordinates
    return "https://www.google.com/maps?q=" + CFG.lat + "," + CFG.lng + "&z=17&hl=en&output=embed";
  }
  function placeHref(){
    var atHome = (CFG.lat === HOME.lat && CFG.lng === HOME.lng);
    return (atHome && CFG.cid)
      ? "https://maps.google.com/?cid=" + CFG.cid
      : "https://www.google.com/maps/search/?api=1&query=" + CFG.lat + "," + CFG.lng;
  }
  function applyMap(){
    var f = $("[data-map]");
    if(f && f.getAttribute("src") !== mapEmbed()) f.setAttribute("src", mapEmbed());
    $$("[data-directions]").forEach(function(n){
      n.setAttribute("href", "https://www.google.com/maps/dir/?api=1&destination=" +
        encodeURIComponent(CFG.lat + "," + CFG.lng));
    });
    $$("[data-placelink], [data-review]").forEach(function(n){ n.setAttribute("href", placeHref()); });
  }
  function ytId(value){
    if(!value) return "";
    var text = String(value).trim().replace(/&amp;/g, "&");
    var src = text.match(/<iframe[^>]+src\s*=\s*[\"']([^\"']+)[\"']/i);
    var url = (src ? src[1] : text).trim();
    var m = url.match(/[?&]v=([\w-]{6,})/) || url.match(/youtu\.be\/([\w-]{6,})/) ||
            url.match(/embed\/([\w-]{6,})/) || url.match(/shorts\/([\w-]{6,})/) ||
            url.match(/live\/([\w-]{6,})/);
    return m ? m[1] : "";
  }
  function normalizeYtEmbed(value){
    if(!value) return "";
    var text = String(value).trim().replace(/&amp;/g, "&");
    var src = text.match(/<iframe[^>]+src\s*=\s*[\"']([^\"']+)[\"']/i);
    return (src ? src[1] : text).trim();
  }
  var VIDEO_TITLES = ["Hospital video", "Awareness video", "Patient story"];
  function applyVideos(){
    $$(".vids .vid").forEach(function(slot, i){
      var id = ytId(CFG.videos[i] || ""), title = VIDEO_TITLES[i] || "Video";
      if(id){
        slot.classList.remove("vid--empty");
        slot.innerHTML = '<iframe data-video src="https://www.youtube.com/embed/' + esc(id) + '" title="' + esc(title) +
          '" allowfullscreen loading="lazy"></iframe>';
      } else {
        slot.classList.add("vid--empty");
        slot.innerHTML = '<div class="vid__empty"><span class="vid__play" aria-hidden="true"></span><b>' + esc(title) +
          '</b><span>Video coming soon</span></div>';
      }
    });
  }
  /* =====================================================
     REVIEWS
     Static reviews supplied for the website. No live Google review API is used.
     ===================================================== */
  function starText(n){
    n = Math.max(0, Math.min(5, Math.round(Number(n) || 0)));
    return "★★★★★".slice(0, n) + "☆☆☆☆☆".slice(0, 5 - n);
  }
  function reviewCard(r){
    var q = document.createElement("blockquote"); q.className = "rev";
    var top = document.createElement("div"); top.className = "rev__top";
    var av = document.createElement("span"); av.className = "rev__av"; av.setAttribute("aria-hidden", "true");
    av.textContent = (r.name || "?").trim().charAt(0).toUpperCase() || "?";
    var who = document.createElement("div"); who.className = "rev__who";
    var cite = document.createElement("cite"); cite.textContent = r.name || "Google user";
    var meta = document.createElement("span"); meta.className = "rev__meta";
    meta.textContent = (r.when ? r.when + " · " : "") + "Google review";
    who.appendChild(cite); who.appendChild(meta); top.appendChild(av); top.appendChild(who);
    var st = document.createElement("div"); st.className = "stars"; st.setAttribute("aria-label", r.stars + " out of 5 stars"); st.textContent = starText(r.stars);
    var p = document.createElement("p"); p.textContent = r.text;
    q.appendChild(top); q.appendChild(st); q.appendChild(p);
    return q;
  }
  function renderReviews(){
    var list = $("#revList");
    if(!list) return;
    list.innerHTML = "";
    (CFG.reviews || []).forEach(function(r){ if(r && r.text) list.appendChild(reviewCard(r)); });
    list.style.display = list.children.length ? "" : "none";
  }
  function applyAll(){ applyContact(); applyMap(); applyVideos(); renderReviews(); }

  /* =====================================================
     PUBLIC PAGE BEHAVIOUR
     ===================================================== */
  var burger = $("#burger"), links = $("#navlinks");
  burger.addEventListener("click", function(){
    var open = links.classList.toggle("open");
    burger.setAttribute("aria-expanded", open ? "true" : "false");
  });
  links.addEventListener("click", function(e){
    if(e.target.tagName === "A" && !document.body.classList.contains("editing")) {
      links.classList.remove("open");
      burger.setAttribute("aria-expanded","false");
    }
  });
  document.addEventListener("click", function(e){
    if(!links.classList.contains("open")) return;
    if(e.target.closest(".nav")) return;
    links.classList.remove("open"); burger.setAttribute("aria-expanded","false");
  });

  function formData(){
    return {
      name:  ($("#f-name").value  || "").trim(),
      phone: ($("#f-phone").value || "").trim(),
      dept:  $("#f-dept").value,
      msg:   ($("#f-msg").value   || "").trim()
    };
  }
  function compose(){
    var d = formData();
    if(!d.name || !d.phone){ toast("Please add your name and phone number first."); return null; }
    return "Appointment request\nName: " + d.name + "\nPhone: " + d.phone +
           "\nDoctor: " + d.dept + "\nMessage: " + (d.msg || "-");
  }
  $("#sendWa").addEventListener("click", function(){
    var t = compose(); if(!t) return;
    window.open("https://wa.me/" + CFG.wa + "?text=" + encodeURIComponent(t), "_blank");
  });
  $("#sendMail").addEventListener("click", function(){
    var t = compose(); if(!t) return;
    window.location.href = "mailto:" + CFG.email + "?subject=" +
      encodeURIComponent("Appointment request") + "&body=" + encodeURIComponent(t);
  });

  /* ---------- gallery lightbox ---------- */
  document.addEventListener("click", function(e){
    if(document.body.classList.contains("editing")) return;
    if(document.body.classList.contains("dash-open")) return;
    var img = e.target.closest(".gal img"); if(!img) return;
    var o = document.createElement("div");
    o.style.cssText = "position:fixed;inset:0;z-index:500;background:rgba(10,30,26,.93);display:grid;place-items:center;padding:20px;cursor:zoom-out";
    var big = new Image(); big.src = img.src; big.alt = img.alt || "";
    big.style.cssText = "max-width:100%;max-height:100%;border-radius:14px";
    o.appendChild(big);
    o.addEventListener("click", function(){ o.remove(); });
    document.body.appendChild(o);
  });

  /* =====================================================
     IMAGE REPLACEMENT (shared by dashboard + inline editing)
     ===================================================== */
  var picker = document.createElement("input");
  picker.type = "file"; picker.accept = "image/*"; picker.style.display = "none";
  picker.setAttribute("data-picker","");
  document.body.appendChild(picker);
  var pickTarget = null, pickAfter = null;

  function shrink(file, maxW, done){
    var fr = new FileReader();
    fr.onload = function(){
      var im = new Image();
      im.onload = function(){
        var w = im.naturalWidth, h = im.naturalHeight;
        if(!w || !h){ done(fr.result); return; }
        if(w > maxW){ h = Math.round(h * maxW / w); w = maxW; }
        try{
          var cv = document.createElement("canvas");
          cv.width = w; cv.height = h;
          var cx = cv.getContext("2d");
          cx.fillStyle = "#fff"; cx.fillRect(0,0,w,h);
          cx.drawImage(im, 0, 0, w, h);
          done(cv.toDataURL("image/jpeg", 0.82));
        }catch(err){ done(fr.result); }
      };
      im.onerror = function(){ done(fr.result); };
      im.src = fr.result;
    };
    fr.onerror = function(){ toast("That file could not be read."); };
    fr.readAsDataURL(file);
  }
  picker.addEventListener("change", function(){
    var f = picker.files && picker.files[0];
    picker.value = "";
    if(!f || !pickTarget) return;
    if(!/^image\//.test(f.type)){ toast("Please choose an image file."); return; }
    var target = pickTarget, after = pickAfter;
    pickTarget = null; pickAfter = null;
    toast("Preparing the picture…");
    shrink(f, 1600, function(dataUrl){
      target.src = dataUrl;
      save();
      toast("Picture updated. Changes are published to the server.");
      if(after) after();
    });
  });
  function replaceImage(img, after){ pickTarget = img; pickAfter = after || null; picker.click(); }

  /* =====================================================
     INLINE PAGE EDITING
     ===================================================== */
  var showControls = false;
  function decorate(){
    $$("[data-e]").forEach(function(n){ n.setAttribute("contenteditable","true"); });
    if(showControls) addControls();
  }
  function addControls(){
    $$("[data-list]").forEach(function(list){
      if(!$(".addbtn[data-add]", list.parentNode)){
        var b = document.createElement("button");
        b.type = "button"; b.className = "addbtn editonly"; b.setAttribute("data-add","");
        b.textContent = "+ Add item";
        b.addEventListener("click", function(){
          var items = $$(":scope > .repeat", list);
          if(!items.length) return;
          var copy = items[items.length-1].cloneNode(true);
          $$("[data-img]", copy).forEach(function(n){ n.setAttribute("data-img", "x" + Date.now() + Math.floor(Math.random()*999)); });
          list.appendChild(copy);
          undecorate(); decorate(); save();
        });
        list.parentNode.insertBefore(b, list.nextSibling);
      }
    });
    $$(".repeat").forEach(function(item){
      if($(":scope > .xbtn", item)) return;
      var x = document.createElement("button");
      x.type = "button"; x.className = "xbtn"; x.textContent = "×"; x.title = "Remove this item";
      x.addEventListener("click", function(ev){
        ev.stopPropagation();
        if(confirm("Remove this item?")){ item.remove(); save(); }
      });
      if(getComputedStyle(item).position === "static") item.style.position = "relative";
      item.appendChild(x);
    });
  }
  function undecorate(){
    $$("[contenteditable]").forEach(function(n){ n.removeAttribute("contenteditable"); });
    $$(".xbtn, .addbtn[data-add]").forEach(function(n){ n.remove(); });
  }
  function setEditing(on){
    if(on){
      document.body.classList.add("editing");
      decorate(); applyVideos();
      toast("Tap any text to change it, or tap a picture to replace it.");
    } else {
      undecorate();
      document.body.classList.remove("editing");
      applyVideos();
    }
  }
  document.addEventListener("click", function(e){
    if(!document.body.classList.contains("editing")) return;
    var img = e.target.closest("[data-img]"); if(!img) return;
    e.preventDefault(); replaceImage(img);
  });
  $("#btnDone").addEventListener("click", function(){ save(); setEditing(false); toast(SERVER_MODE ? "Changes published." : "Changes published to the server."); });
  $("#btnBackToDash").addEventListener("click", function(){ save(); setEditing(false); location.href = "/admin"; });
  $("#btnAdd").addEventListener("click", function(){
    showControls = !showControls;
    this.textContent = showControls ? "Hide add / remove" : "Show add / remove";
    undecorate(); decorate();
  });
  var saveT;
  document.addEventListener("input", function(e){
    if(!document.body.classList.contains("editing")) return;
    if(e.target.closest(".dash")) return;
    clearTimeout(saveT); saveT = setTimeout(save, 700);
  });
  window.addEventListener("beforeunload", function(){
    if(document.body.classList.contains("editing")) save();
  });

  /* =====================================================
     DASHBOARD
     ===================================================== */
  var dash = $("#dash");

  function openDash(unlocked){
    document.body.classList.add("dash-open");
    if(unlocked){ serverAuthed = true; dash.removeAttribute("data-locked"); refreshDash(); }
    else {
      dash.setAttribute("data-locked","");
      $("#dpwMsg").textContent = ""; $("#duser").value = ""; $("#dpw").value = "";
      setTimeout(function(){ $("#duser").focus(); }, 60);
    }
  }
  function closeDash(){
    if(IS_ADMIN_PAGE){ location.href = "/"; return; }
    document.body.classList.remove("dash-open");
  }

  $("#dashClose").addEventListener("click", closeDash);
  $("#dashLogout").addEventListener("click", async function(){
    try{ await fetch("/api/logout",{method:"POST",credentials:"same-origin"}); }catch(e){}
    location.href = "/admin";
  });
  document.addEventListener("keydown", function(e){
    if(e.key === "Escape" && document.body.classList.contains("dash-open")) closeDash();
  });
  async function tryLogin(){
    var u = $("#duser").value.trim(), pw = $("#dpw").value, msg = $("#dpwMsg");
    if(!u || !pw){ msg.textContent = "Enter the username and password."; return; }
    if(!SERVER_MODE){
      msg.textContent = "The dashboard needs to run through the server. Start server.js and open the site from it.";
      return;
    }
    msg.textContent = "Signing in…";
    try{
      var r = await fetch("/api/login",{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        credentials:"same-origin",
        body:JSON.stringify({username:u,password:pw})
      });
      if(r.status === 401){
        msg.textContent = "Username or password is incorrect.";
        return;
      }
      if(!r.ok) throw new Error("login failed");
      location.href = "/admin";
    }catch(e){
      msg.textContent = "Cannot reach the admin server. Please open the site through the Node server on port 3000.";
    }
  }
  $("#dpwGo").addEventListener("click", tryLogin);
  $("#duser").addEventListener("keydown", function(e){ if(e.key === "Enter") $("#dpw").focus(); });
  $("#dpw").addEventListener("keydown", function(e){ if(e.key === "Enter") tryLogin(); });

  /* ---------- tabs ---------- */
  function showTab(name){
    $$(".dtab", dash).forEach(function(t){ t.setAttribute("aria-selected", t.getAttribute("data-tab") === name ? "true" : "false"); });
    $$(".dpanel", dash).forEach(function(p){
      if(p.getAttribute("data-panel") === name) p.setAttribute("data-open","");
      else p.removeAttribute("data-open");
    });
    var c = $(".dash__content", dash); if(c) c.scrollTop = 0;
  }
  dash.addEventListener("click", function(e){
    var t = e.target.closest(".dtab");
    if(t){ showTab(t.getAttribute("data-tab")); return; }
    var g = e.target.closest("[data-goto]");
    if(g){ showTab(g.getAttribute("data-goto")); }
  });

  /* ---------- pictures panel ---------- */
  function siteImages(){
    return $$("[data-img]").filter(function(n){ return !n.closest(".dash"); });
  }
  function buildPics(){
    var grid = $("#picGrid");
    grid.innerHTML = "";
    siteImages().forEach(function(img){
      var key = img.getAttribute("data-img");
      var name = img.getAttribute("data-label") || img.alt || key;
      var card = document.createElement("div");
      card.className = "dimg";
      card.innerHTML =
        '<img class="dimg__thumb" alt="">' +
        '<div class="dimg__b"><div class="dimg__name">' + esc(name) + '</div>' +
        '<div class="dimg__row"><button type="button" data-act="rep">Replace</button>' +
        (DEFAULT_IMG[key] ? '<button type="button" data-act="res">Undo</button>' : '') +
        '</div></div>';
      $(".dimg__thumb", card).src = img.src;
      $('[data-act="rep"]', card).addEventListener("click", function(){
        replaceImage(img, function(){ $(".dimg__thumb", card).src = img.src; });
      });
      var r = $('[data-act="res"]', card);
      if(r) r.addEventListener("click", function(){
        img.src = DEFAULT_IMG[key];
        $(".dimg__thumb", card).src = img.src;
        save(); toast("Original picture restored.");
      });
      grid.appendChild(card);
    });
  }

  /* ---------- gallery panel ---------- */
  var BLANK = "data:image/svg+xml;utf8," + encodeURIComponent(
    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 300'><rect width='400' height='300' fill='#E7EFEC'/>" +
    "<rect x='150' y='118' width='100' height='72' rx='8' fill='none' stroke='#A8C0BA' stroke-width='5'/>" +
    "<circle cx='176' cy='143' r='9' fill='#A8C0BA'/><path d='M156 182l30-28 22 20 16-14 20 24z' fill='#A8C0BA'/></svg>");

  function buildGallery(){
    var host = $("#galList");
    host.innerHTML = "";
    var figs = $$("#gallery .gal figure");
    if(!figs.length){ host.innerHTML = '<div class="dsec"><p>There are no gallery pictures yet. Use the button below to add the first one.</p></div>'; return; }
    figs.forEach(function(fig, i){
      var img = $("img", fig), cap = $("figcaption", fig);
      var row = document.createElement("div");
      row.className = "drow";
      row.innerHTML =
        '<img alt="">' +
        '<div><div class="dfield"><label>Caption</label><input type="text"></div>' +
        '<div class="dactions"><button class="dbtn" type="button" data-act="rep">Replace picture</button>' +
        '<button class="dbtn dbtn--warn" type="button" data-act="del">Remove</button></div></div>';
      var thumb = $("img", row), input = $("input", row);
      thumb.src = img ? img.src : BLANK;
      input.value = cap ? cap.textContent.trim() : "";
      input.addEventListener("input", function(){
        if(cap) cap.textContent = input.value;
        clearTimeout(saveT); saveT = setTimeout(save, 500);
      });
      $('[data-act="rep"]', row).addEventListener("click", function(){
        if(!img) return;
        replaceImage(img, function(){ thumb.src = img.src; buildPics(); });
      });
      $('[data-act="del"]', row).addEventListener("click", function(){
        if(!confirm("Remove picture " + (i+1) + " from the gallery?")) return;
        fig.remove(); save(); refreshDash(); toast("Gallery picture removed.");
      });
      host.appendChild(row);
    });
  }
  $("#galAdd").addEventListener("click", function(){
    var gal = $("#gallery .gal"); if(!gal) return;
    var fig = document.createElement("figure");
    fig.className = "repeat";
    var key = "g" + Date.now();
    fig.innerHTML = '<img data-img="' + key + '" data-label="Gallery picture" alt="Hospital photo" src="' + BLANK + '">' +
                    '<figcaption data-e>New picture</figcaption>';
    gal.appendChild(fig);
    save(); refreshDash();
    replaceImage($("img", fig), function(){ refreshDash(); });
  });

  /* ---------- contact panel ---------- */
  function fillContact(){
    $("#cPhone").value = CFG.phone; $("#cDial").value = CFG.dial;
    $("#cWa").value    = CFG.wa;    $("#cEmail").value = CFG.email;
    $("#cAddr").value  = CFG.address;
    $("#cFb").value = CFG.facebook; $("#cIg").value = CFG.instagram; $("#cYt").value = CFG.youtube;
    $("#cMap").value = CFG.lat + ", " + CFG.lng;
    fillReviewsPanel();
    $("#cEmbed").value = CFG.embed || "";
    $("#v1").value = CFG.videos[0] || ""; $("#v2").value = CFG.videos[1] || ""; $("#v3").value = CFG.videos[2] || "";
  }
  $("#cSave").addEventListener("click", function(){
    CFG.phone = $("#cPhone").value.trim() || CFG.phone;
    CFG.dial  = $("#cDial").value.trim()  || CFG.dial;
    CFG.wa    = $("#cWa").value.replace(/\D/g,"") || CFG.wa;
    CFG.email = $("#cEmail").value.trim() || CFG.email;
    CFG.address = $("#cAddr").value.trim() || CFG.address;
    CFG.facebook = $("#cFb").value.trim();
    CFG.instagram = $("#cIg").value.trim();
    CFG.youtube = $("#cYt").value.trim();
    applyContact(); save(); toast("Contact details updated across the site.");
  });

  /* ---------- google reviews panel ---------- */
  function revRow(r){
    var row = document.createElement("div"); row.className = "revrow";
    row.innerHTML =
      '<label>Reviewer name, exactly as on Google<input type="text" data-k="name" autocomplete="off"></label>' +
      '<label>Stars<select data-k="stars"><option>5</option><option>4</option><option>3</option><option>2</option><option>1</option></select></label>' +
      '<label>When (optional), for example &ldquo;2 months ago&rdquo;<input type="text" data-k="when" autocomplete="off"></label>' +
      '<label>Review text<textarea data-k="text"></textarea></label>' +
      '<button type="button" class="dbtn dbtn--warn" data-rm>Remove this review</button>';
    $("[data-k=name]", row).value = r.name || "";
    $("[data-k=stars]", row).value = String(r.stars || 5);
    $("[data-k=when]", row).value = r.when || "";
    $("[data-k=text]", row).value = r.text || "";
    $("[data-rm]", row).addEventListener("click", function(){ row.remove(); });
    return row;
  }
  function fillReviewsPanel(){
    var box = $("#revRows"); box.innerHTML = "";
    (CFG.reviews || []).forEach(function(r){ box.appendChild(revRow(r)); });
  }
  $("#revAdd").addEventListener("click", function(){ $("#revRows").appendChild(revRow({stars:5})); });
  $("#revSave").addEventListener("click", function(){
    var out = [];
    $$(".revrow", $("#revRows")).forEach(function(row){
      var g = function(k){ return $("[data-k=" + k + "]", row).value.trim(); };
      if(g("text")) out.push({name: g("name"), stars: parseInt(g("stars"), 10) || 5, when: g("when"), text: g("text")});
    });
    CFG.reviews = out; save(); renderReviews();
    var m = $("#revMsg"); m.style.color = "#0A5249";
    m.textContent = out.length ? ("Saved " + out.length + (out.length === 1 ? " review." : " reviews.")) : "No reviews saved — the reviews grid is hidden until you add one.";
    toast("Reviews updated.");
  });
  function parseLatLng(s){
    s = (s || "").trim(); var m;
    m = s.match(/!3d(-?\d+(?:\.\d+)?)!4d(-?\d+(?:\.\d+)?)/);      if(m) return [m[1], m[2]];
    m = s.match(/@(-?\d+(?:\.\d+)?),(-?\d+(?:\.\d+)?)/);          if(m) return [m[1], m[2]];
    m = s.match(/[?&]q=(-?\d+(?:\.\d+)?)(?:,|%2C)(-?\d+(?:\.\d+)?)/i); if(m) return [m[1], m[2]];
    m = s.match(/^(-?\d+(?:\.\d+)?)\s*,\s*(-?\d+(?:\.\d+)?)$/);   if(m) return [m[1], m[2]];
    return null;
  }
  $("#mapApply").addEventListener("click", function(){
    var raw = $("#cMap").value, msg = $("#mapMsg");
    if(/goo\.gl/.test(raw)){
      msg.textContent = "That is a short link. Open it in Google Maps first, then copy the long address from the browser bar.";
      return;
    }
    var p = parseLatLng(raw);
    if(!p){
      msg.textContent = "No coordinates found. Paste a full Google Maps address, or type latitude, longitude.";
      return;
    }
    var la = parseFloat(p[0]), ln = parseFloat(p[1]);
    if(!(la >= -90 && la <= 90) || !(ln >= -180 && ln <= 180)){
      msg.textContent = "Those numbers are outside the valid range for latitude and longitude.";
      return;
    }
    CFG.lat = p[0]; CFG.lng = p[1]; CFG.embed = ""; $("#cEmbed").value = "";
    msg.style.color = "#0A5249";
    msg.textContent = "Map moved to " + CFG.lat + ", " + CFG.lng + ".";
    applyMap(); save(); toast("Map updated.");
  });
  $("#mapReset").addEventListener("click", function(){
    CFG.lat = HOME.lat; CFG.lng = HOME.lng; CFG.cid = HOME.cid; CFG.embed = ""; $("#cEmbed").value = "";
    $("#cMap").value = CFG.lat + ", " + CFG.lng;
    $("#mapMsg").style.color = "#0A5249";
    $("#mapMsg").textContent = "Pin put back on the hospital.";
    applyMap(); save(); toast("Map pin reset.");
  });

  $("#embedApply").addEventListener("click", function(){
    var raw = $("#cEmbed").value.trim(), msg = $("#embedMsg");
    var m = raw.match(/src\s*=\s*["']([^"']+)["']/i);
    var url = (m ? m[1] : raw).replace(/&amp;/g, "&").trim();
    if(!url){ CFG.embed = ""; applyMap(); save(); msg.style.color = "#0A5249"; msg.textContent = "Cleared. The standard map is showing."; return; }
    if(!/^https:\/\/www\.google\.com\/maps\/embed\?/.test(url)){
      msg.style.color = "#A83226";
      msg.textContent = "That is not a Google Maps embed. It should contain src=\"https://www.google.com/maps/embed?pb=...\".";
      return;
    }
    CFG.embed = url; applyMap(); save();
    msg.style.color = "#0A5249"; msg.textContent = "Done. The map on the page now uses Google's embed."; toast("Map updated.");
  });

  /* ---------- videos panel ---------- */
  document.addEventListener("click", function(e){
    if(!e.target.closest("[data-setvideos]")) return;
    for(var i = 0; i < 3; i++){
      var cur = CFG.videos[i] || "";
      var url = prompt("YouTube link for video " + (i + 1) + " (leave blank to keep it as it is, type - to clear it):", cur);
      if(url === null) break;                         // cancelled
      url = url.trim();
      if(url === "-"){ CFG.videos[i] = ""; continue; }
      if(!url) continue;
      if(!ytId(url)){ toast("Video " + (i + 1) + ": paste a YouTube link or YouTube embed code."); continue; }
      CFG.videos[i] = normalizeYtEmbed(url);
    }
    applyVideos(); save(); toast("Videos updated.");
  });
  $("#vSave").addEventListener("click", function(){
    var rawVals = [$("#v1").value.trim(), $("#v2").value.trim(), $("#v3").value.trim()];
    var bad = rawVals.filter(function(v){ return v && !ytId(v); });
    var vals = rawVals.map(function(v){ return normalizeYtEmbed(v); });
    var msg = $("#vMsg");
    if(bad.length){
      msg.style.color = "#A83226";
      msg.textContent = "One of those is not valid. Paste a normal YouTube link or the full Embed HTML from Share → Embed.";
      return;
    }
    CFG.videos = vals;
    applyVideos(); save(); refreshDash();
    msg.style.color = "#0A5249";
    msg.textContent = "Videos saved.";
  });
  $("#vClear").addEventListener("click", function(){
    if(!confirm("Clear all three video links?")) return;
    CFG.videos = ["","",""];
    $("#v1").value = ""; $("#v2").value = ""; $("#v3").value = "";
    applyVideos(); save(); refreshDash();
    $("#vMsg").style.color = "#0A5249";
    $("#vMsg").textContent = "All video links cleared.";
  });

  /* ---------- page text panel ---------- */
  function startEditing(){ location.href = "/?edit=1"; }
  $("#goEdit").addEventListener("click", startEditing);
  $("#goEdit2").addEventListener("click", startEditing);
  $("#btnReset").addEventListener("click", function(){
    if(confirm("Reload the latest version saved on the server?")){
      location.reload();
    }
  });

  /* ---------- publish panel ---------- */
  $("#btnExport").addEventListener("click", function(){
    save();
    var wasEditing = document.body.classList.contains("editing");
    undecorate();
    document.body.classList.remove("editing");
    var dashWasOpen = document.body.classList.contains("dash-open");
    document.body.classList.remove("dash-open");

    var doc = document.documentElement.cloneNode(true);
    $$("[data-picker]", doc).forEach(function(n){ n.remove(); });
    $$(".xbtn, .addbtn[data-add]", doc).forEach(function(n){ n.remove(); });
    $$("[contenteditable]", doc).forEach(function(n){ n.removeAttribute("contenteditable"); });
    $$(".nav", doc).forEach(function(n){ n.classList.remove("is-tight", "is-compact"); });
    var t = $("#toast", doc); if(t){ t.textContent = ""; t.className = "toast"; }
    var d = $("#dash", doc); if(d){ d.setAttribute("data-locked",""); }
    $$("#duser, #dpw, #cMap, #cEmbed", doc).forEach(function(n){ n.removeAttribute("value"); n.value = ""; });
    $$(".dmsg", doc).forEach(function(n){ n.textContent = ""; });
    $$("#picGrid, #galList, #revRows", doc).forEach(function(n){ n.innerHTML = ""; });
    $$("[data-live]", doc).forEach(function(n){ n.innerHTML = ""; });
    doc.setAttribute("data-build", "build-" + Date.now());

    var html = "<!DOCTYPE html>\n" + doc.outerHTML;
    html = html.replace(/var CFG_DEFAULTS = \{[\s\S]*?\}; \/\*CFG\*\//,
                        function(){ return "var CFG_DEFAULTS = " + JSON.stringify(CFG) + "; /*CFG*/"; });   // function: review text may contain $ sequences

    var blob = new Blob([html], {type:"text/html"});
    var a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = "dr-dixit-bilaspur-hospital.html";
    document.body.appendChild(a); a.click();
    setTimeout(function(){ URL.revokeObjectURL(a.href); a.remove(); }, 1000);

    if(dashWasOpen) document.body.classList.add("dash-open");
    if(wasEditing) setEditing(true);
    toast("Backup downloaded. Normal dashboard changes are published directly to the server.");
  });

  /* ---------- refresh everything in the dashboard ---------- */
  function refreshDash(){
    if(dash.hasAttribute("data-locked")) return;
    buildPics(); buildGallery(); fillContact();
    $("#statPics").textContent = siteImages().length;
    $("#statGal").textContent  = $$("#gallery .gal figure").length;
    $("#statVid").textContent  = CFG.videos.filter(function(v){ return !!ytId(v); }).length;
    $("#statSaved").textContent = savedNote;
    renderAnalytics();
  }

  /* =====================================================
     BOOT
     ===================================================== */
  (function boot(){
    applyAll();
    if(IS_ADMIN_PAGE){
      openDash(serverAuthed);
      if(serverAuthed) refreshDash();
      return;
    }
    var edit = new URLSearchParams(location.search).get("edit") === "1";
    if(edit){
      if(serverAuthed){
        setEditing(true);
      }else{
        location.href = "/admin";
      }
    }
  })();
})();
</script></body>
</html>
